<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/green_border">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adjust Macro Percentages"
        android:textSize="20sp"
        android:textColor="@color/darkGreen"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Protein Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Protein"
            android:textColor="@color/darkGreen"/>

        <SeekBar
            android:id="@+id/proteinSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:progressTint="@color/darkGreen"
            android:thumbTint="@color/darkGreen"/>

        <TextView
            android:id="@+id/proteinPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30%"
            android:textColor="@color/darkGreen"
            android:layout_gravity="end"/>
    </LinearLayout>

    <!-- Fats Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fats"
            android:textColor="@color/darkGreen"/>

        <SeekBar
            android:id="@+id/fatsSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:progressTint="@color/darkGreen"
            android:thumbTint="@color/darkGreen"/>

        <TextView
            android:id="@+id/fatsPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30%"
            android:textColor="@color/darkGreen"
            android:layout_gravity="end"/>
    </LinearLayout>

    <!-- Carbs Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carbs"
            android:textColor="@color/darkGreen"/>

        <SeekBar
            android:id="@+id/carbsSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="40"
            android:progressTint="@color/darkGreen"
            android:thumbTint="@color/darkGreen"/>

        <TextView
            android:id="@+id/carbsPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="40%"
            android:textColor="@color/darkGreen"
            android:layout_gravity="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/totalPercentage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: 100%"
        android:textColor="@color/darkGreen"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>