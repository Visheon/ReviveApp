<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/default_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="85dp"
        android:background="@drawable/green_border"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meal Creation"
            android:textAlignment="center"
            android:layout_gravity="center"
            android:textColor="@color/darkGreen"
            android:textStyle="bold"
            android:textSize="30sp"/>

        <EditText
            android:id="@+id/mealNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter meal name"
            android:layout_marginTop="4dp"
            android:textColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"/>

        <TextView
            android:id="@+id/mealTotalCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/darkGreen"
            android:text="Total Calories: 0"/>

        <TextView
            android:id="@+id/mealTotalNutrients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/darkGreen"
            android:text="Nutrient Details"/>

        <Button
            android:id="@+id/addFoodButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Food Item"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/selectedFoodsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/saveMealButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Meal"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"/>

    </LinearLayout>
</FrameLayout>