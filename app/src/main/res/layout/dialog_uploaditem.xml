<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/green_border">
            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Food Item"
                android:textSize="30sp"
                android:textAlignment="center"
                android:textColor="@color/darkGreen"/>

            <!-- Name Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/green_border"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name:"
                    android:textColor="@color/darkGreen"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/uploadItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Enter name (no repeats)"
                    android:textColor="@color/darkGreen"
                    android:textColorHint="@color/black"/>
            </LinearLayout>

            <!-- Nutritional Info Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:background="@drawable/green_border">

                <!-- Calories -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Calories:"
                        android:textColor="@color/darkGreen"
                        android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/uploadCalories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textAlignment="viewEnd"
                        android:hint="per 100g"
                        android:inputType="numberDecimal"
                        android:textColor="@color/darkGreen"
                        android:textColorHint="@color/black"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/darkGreen"
                    android:alpha="0.5"/>

                <!-- Protein -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Protein:"
                        android:textColor="@color/darkGreen"
                        android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/uploadProtein"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewEnd"
                        android:background="@null"
                        android:hint="per 100g"
                        android:inputType="numberDecimal"
                        android:textColor="@color/darkGreen"
                        android:textColorHint="@color/black"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/darkGreen"
                    android:alpha="0.5"/>

                <!-- Fats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Fats:"
                        android:textColor="@color/darkGreen"
                        android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/uploadFats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewEnd"
                        android:background="@null"
                        android:hint="per 100g"
                        android:inputType="numberDecimal"
                        android:textColor="@color/darkGreen"
                        android:textColorHint="@color/black"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/darkGreen"
                    android:alpha="0.5"/>

                <!-- Carbs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Carbs:"
                        android:textColor="@color/darkGreen"
                        android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/uploadCarbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textAlignment="viewEnd"
                        android:hint="per 100g"
                        android:inputType="numberDecimal"
                        android:textColor="@color/darkGreen"
                        android:textColorHint="@color/black"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:id="@+id/itemCancelButton"
                    android:textSize="18sp"
                    android:backgroundTint="@color/darkGreen"
                    android:layout_marginEnd="10dp"
                    android:textColor="@color/white"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="Save"
                    android:id="@+id/itemsaveButton"
                    android:textSize="18sp"
                    android:backgroundTint="@color/darkGreen"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>