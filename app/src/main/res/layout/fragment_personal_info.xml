<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:layout_marginTop="?attr/actionBarSize"
    android:layout_marginBottom="70dp"
    android:background="@drawable/basicscreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_gravity="center"
            android:layout_marginTop="70dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/green_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Name"
                        android:textStyle="bold"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/readName"
                        android:text=""
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="10dp"
                    android:alpha="0.5"
                    android:background="@color/darkGreen"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Age"
                        android:textStyle="bold"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/readAge"
                        android:text=""
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="20dp"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />

                    <Button
                        android:layout_width="49dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/darkGreen"
                        android:drawableBottom="@drawable/baseline_edit_24"
                        android:id="@+id/btnEditAge"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="10dp"
                    android:alpha="0.5"
                    android:background="@color/darkGreen"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Height (cm)"
                        android:textStyle="bold"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/readHeight"
                        android:text=""
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="20dp"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />

                    <Button
                        android:layout_width="49dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/darkGreen"
                        android:drawableBottom="@drawable/baseline_edit_24"
                        android:id="@+id/btnEditHeight"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="10dp"
                    android:alpha="0.5"
                    android:background="@color/darkGreen"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sex"
                        android:textStyle="bold"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/readSex"
                        android:text=""
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="20dp"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />

                    <Button
                        android:layout_width="49dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/darkGreen"
                        android:drawableBottom="@drawable/baseline_edit_24"
                        android:id="@+id/btnEditSex"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="10dp"
                    android:alpha="0.5"
                    android:background="@color/darkGreen"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weight (kg)"
                        android:textStyle="bold"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/readWeight"
                        android:text=""
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="20dp"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />

                    <Button
                        android:layout_width="49dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/darkGreen"
                        android:drawableBottom="@drawable/baseline_edit_24"
                        android:id="@+id/btnEditWeight"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="10dp"
                    android:alpha="0.5"
                    android:background="@color/darkGreen"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Activity Level"
                        android:textStyle="bold"
                        android:textColor="@color/darkGreen"
                        android:textSize="17sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/readActivityLevels"
                        android:text=""
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="20dp"
                        android:textColor="@color/darkGreen"
                        android:textSize="18sp" />

                    <Button
                        android:layout_width="49dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/darkGreen"
                        android:drawableBottom="@drawable/baseline_edit_24"
                        android:id="@+id/btnEditActivityLevel"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="40dp"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="20dp"
            android:text="RECALCULATE CALORIES"
            android:padding="20dp"
            android:textColor="@color/white"
            android:background="@drawable/darkgreen_round_white_outline"
            android:id="@+id/btnRecalculateCalories"/>
    </LinearLayout>
</ScrollView>