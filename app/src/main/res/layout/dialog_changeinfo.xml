<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogchangeinfo"
    android:layout_margin="20dp"
    android:padding="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/dialogBox"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/green_border">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ChangeTitle"
            android:background="@drawable/darkgreen_round_flat_bottom"
            android:padding="10dp"
            android:text="Change Details"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:drawableLeft="@drawable/baseline_edit_24"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="20dp"
            android:text="Enter the new detail"
            android:textColor="@color/darkGreen"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/editBoxDetails"
            app:layout_constraintTop_toBottomOf="@id/ChangeTitle"
            app:layout_constraintVertical_bias="0.0"
            tools:layout_editor_absoluteX="-8dp" />

        <EditText
            android:id="@+id/editBoxDetails"
            android:layout_width="309dp"
            android:layout_height="61dp"
            android:layout_marginStart="20sp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="@color/darkGreen"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/darkGreen"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ChangeTitle"
            tools:ignore="SpeakableTextPresentCheck" />
        <Button
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:id="@+id/btnCancelDetails"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="Cancel"
            android:layout_marginBottom="8dp"
            app:cornerRadius = "20dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/editBoxDetails"
            app:layout_constraintBottom_toBottomOf="@id/dialogBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnChangeDetail"
            android:backgroundTint="@color/darkGreen"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:id="@+id/btnChangeDetail"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="40dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="10dp"
            android:text="Change"
            app:cornerRadius = "20dp"
            app:layout_constraintBottom_toBottomOf="@id/dialogBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCancelDetails"
            android:backgroundTint="@color/darkGreen"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>