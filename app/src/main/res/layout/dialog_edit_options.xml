<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/green_border">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Item"
        android:textSize="24sp"
        android:textColor="@color/darkGreen"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:drawableLeft="@drawable/baseline_edit_24"
        android:drawableTint="@color/darkGreen"/>

    <Button
        android:id="@+id/editNameButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Name"
        android:backgroundTint="@color/darkGreen"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/editCaloriesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Calories"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/editProteinsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Proteins"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/editFatsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Fats"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/editCarbsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Carbs"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="@color/darkGreen"
            android:textColor="@color/white"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

</LinearLayout>